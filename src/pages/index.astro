---
import Layout from '../layouts/Layout.astro'

import { hero, about, homeRows } from '../content/index'
---

<Layout title='Aspirare Semi'>
  <main>
    <div class='container'>
      <section id='hero'>
        <h1>{hero.title}</h1>
        <div class='intro'>
          {hero.body.map((text) => <p>{text}</p>)}
          {about.body.map((text) => <p>{text}</p>)}
        </div>
      </section>

      <div class='home-rows'>
        {
          homeRows.map((row) => (
            <div class='home-row'>
              <div class='home-row-label'>{row.label}</div>
              <div class='home-row-content'>
                {row.items && (
                  <ul>
                    {row.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
                {row.body && row.body.map((text) => <p>{text}</p>)}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </main>
</Layout>

<style>
  .intro {
    margin-bottom: 3.5rem;
  }

  .home-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
  }

  .home-row-label {
    font-size: 0.75rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    padding-top: 0.25rem;
  }

  .home-row-content p,
  .home-row-content li {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  .home-row-content p + p {
    margin-top: 0.75rem;
  }

  .home-row-content ul {
    margin: 0;
    padding-left: 0.875rem;
    list-style: none;
  }

  .home-row-content li {
    margin-bottom: 0.5rem;
  }

  .home-row-content li:last-child {
    margin-bottom: 0;
  }

  .home-row-content li::before {
    content: '–';
    color: #bbb;
    margin-left: -0.875rem;
    margin-right: 0.25rem;
  }

  @media screen and (min-width: 768px) {
    .home-row {
      grid-template-columns: 140px 1fr;
      gap: 1.25rem;
    }
  }
</style>
