---
import '../styles/layout.css'

import { navLinks, footerLinks, copyright } from '../content/global'

const { default: aspirareLogoHtml } = await import(
  `../assets/svg/aspirareLogo.svg?raw`
)

interface Props {
  title: string
}

const { title } = Astro.props
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='description' content='Aspirare Semi' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap'
      rel='stylesheet'
    />
    <meta name='generator' content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <div class='container header-inner'>
        <a class='logo' href='/' title='Aspirare Semi'>
          <Fragment set:html={aspirareLogoHtml} />
        </a>
        <nav>
          <ul>
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.url}
                    aria-current={
                      currentPath === link.url ? 'page' : undefined
                    }
                  >
                    {link.text}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <button
          class='mobile-menu-toggle'
          aria-label='Toggle menu'
          aria-expanded='false'
        >
          <div class='hamburger'>
            <span></span>
            <span></span>
            <span></span>
          </div>
        </button>
      </div>
    </header>

    <div class='mobile-menu-overlay'>
      <div class='mobile-menu-content'>
        {
          navLinks.map((link) => (
            <a
              href={link.url}
              aria-current={currentPath === link.url ? 'page' : undefined}
            >
              {link.text}
            </a>
          ))
        }
      </div>
    </div>

    <slot />

    <footer>
      <div class='container footer-inner'>
        <div>{copyright}</div>
        <ul>
          {
            footerLinks.map((link) => (
              <li>
                <a href={link.url}>{link.text}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('.mobile-menu-toggle')
      const overlay = document.querySelector('.mobile-menu-overlay')

      function closeMenu() {
        overlay?.classList.remove('active')
        toggle?.setAttribute('aria-expanded', 'false')
        document.body.classList.remove('menu-open')
      }

      toggle?.addEventListener('click', () => {
        const isOpen = overlay?.classList.toggle('active') ?? false
        toggle.setAttribute('aria-expanded', `${isOpen}`)
        document.body.classList.toggle('menu-open', isOpen)
      })

      overlay?.addEventListener('click', closeMenu)
    </script>
  </body>
</html>
